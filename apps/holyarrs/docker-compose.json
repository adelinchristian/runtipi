{
  "services": [
    {
      "name": "holyarrs",
      "image": "holyarrs/holyarrs:1.2.0",
      "isMain": true,
      "internalPort": "6262",
      "environment": {
        "PUID": "1000",
        "PGID": "1000",
        "TZ": "${TZ}"
      },
      "volumes": [
        {
          "containerPath": "/config",
          "hostPath": "${APP_DATA_DIR}/data/config",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "containerPath": "/share/Download",
          "hostPath": "/share/Download",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "hostname": "holyarrs"
    }
  ],
  "schemaVersion": 2
}
