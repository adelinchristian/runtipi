{
  "services": [
    {
      "name": "holyarrs",
      "image": "holyarrs/holyarrs:1.2.0",
      "isMain": true,
      "internalPort": "6262",
      "environment": [
        {
          "key": "PUID",
          "value": "1000"
        },
        {
          "key": "PGID",
          "value": "1000"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "volumes": [
        {
          "containerPath": "/config",
          "hostPath": "${APP_DATA_DIR}/data/config",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "containerPath": "/share/Download",
          "hostPath": "/share/Download",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "hostname": "holyarrs"
    }
  ],
  "schemaVersion": 2
}
