{
  "services": [
    {
      "name": "frigate",
      "image": "ghcr.io/blakeblackshear/frigate:stable",
      "isMain": true,
      "internalPort": "8971",
      "addPorts": [
        {
          "containerPort": 8554,
          "hostPort": 8554,
          "interface": "0.0.0.0",
          "tcp": true
        },
        {
          "containerPort": 8555,
          "hostPort": 8555,
          "interface": "0.0.0.0",
          "tcp": true
        },
        {
          "containerPort": 8555,
          "hostPort": 8555,
          "interface": "0.0.0.0",
          "udp": true
        }
      ],
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "volumes": [
        {
          "containerPath": "/etc/localtime",
          "hostPath": "/etc/localtime",
          "readOnly": true,
          "shared": false,
          "private": false
        },
        {
          "containerPath": "/config",
          "hostPath": "${APP_DATA_DIR}/data/config",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "containerPath": "/media/frigate",
          "hostPath": "${APP_DATA_DIR}/data/media",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "devices": [
        "/dev/dri/renderD128:/dev/dri/renderD128"
      ],
      "hostname": "frigate",
      "shmSize": "512mb"
    }
  ],
  "schemaVersion": 2
}