{
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "schemaVersion": 2,
  "services": [
    {
      "name": "opentubex-sync",
      "image": "ghcr.io/opentubex/sync-server:latest-sqlite",
      "isMain": true,
      "internalPort": 8080,
      "environment": [
        {
          "key": "DATABASE_URL",
          "value": "./data/db.sqlite"
        },
        {
          "key": "SECRET_KEY",
          "value": "${OPENTUBEX_SYNC_SECRET}"
        },
        {
          "key": "USERNAME_SECRET",
          "value": "${OPENTUBEX_SYNC_SECRET}"
        },
        {
          "key": "ALLOW_REGISTRATION",
          "value": "${OPENTUBEX_SYNC_ALLOW_REGISTRATION}"
        },
        {
          "key": "MIGRATION_APPROVAL",
          "value": "${OPENTUBEX_SYNC_MIGRATION_APPROVAL:-}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/data"
        }
      ]
    }
  ]
}
